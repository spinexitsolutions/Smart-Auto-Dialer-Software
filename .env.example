# Copy to .env and edit
PORT=3000
BRAND_NAME=Smart Auto Dialer
# Long random string. If empty, one is generated and stored in data/.jwt_secret
JWT_SECRET=
# Vendor (super admin) login created on first start
SUPERADMIN_EMAIL=owner@yourcompany.com
SUPERADMIN_PASSWORD=change-me-now
# Where database and recordings are stored
DATA_DIR=./data
MAX_RECORDING_MB=50
