<?xml version="1.0" encoding="utf-8"?>
<!--
  Agents frequently connect to an on-premise server over plain HTTP on the LAN
  (e.g. http://192.168.1.5:3000), so cleartext traffic is permitted.
  User-installed CAs are trusted as well so customers can use an internal CA
  for HTTPS. Tighten this for deployments that only use public HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
